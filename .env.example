# Copy this file to .env and fill in the values. .env is ignored by Git;
# never commit it.

# --- Django ---
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
DEBUG=True
# Hostname(s) you browse to this site with, comma-separated.
ALLOWED_HOSTS=labs.example.com,localhost,127.0.0.1

# --- Proxmox ---
# Proxmox web UI URL as your browser reaches it (include :8006 if it isn't behind a proxy).
PROXMOX_URL=https://pve.example.com:8006
# Parent domain shared by this site and Proxmox, with a leading dot.
PROXMOX_COOKIE_DOMAIN=.example.com
# Keep true. This site must be served over HTTPS (README step 5) for the console to work.
PROXMOX_COOKIE_SECURE=true
# Realm added when a student logs in without one (student1 -> student1@pve).
PROXMOX_DEFAULT_REALM=pve
# true for a real certificate, false for Proxmox's self-signed one,
# or a path to a copy of /etc/pve/pve-root-ca.pem.
PROXMOX_VERIFY_SSL=true
